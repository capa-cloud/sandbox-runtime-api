{
  "name": "sandbox-runtime-api",
  "version": "0.1.0",
  "private": true,
  "description": "A provider-neutral runtime contract for isolated AI agent execution environments.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/capa-cloud/sandbox-runtime-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capa-cloud/sandbox-runtime-api.git"
  },
  "bugs": {
    "url": "https://github.com/capa-cloud/sandbox-runtime-api/issues"
  },
  "keywords": [
    "agent",
    "sandbox",
    "runtime",
    "provider",
    "conformance"
  ],
  "type": "module",
  "bin": {
    "sandbox-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "spec",
    "DOCS-INDEX.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "NON_GOALS.md",
    "ORIGIN_AND_PROVENANCE.md",
    "ROADMAP.md",
    "SECURITY.md"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level high",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm build && pnpm test:coverage && pnpm pack:check && pnpm audit:dependencies",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:check": "pnpm build && node scripts/check-package.mjs",
    "sanitize": "bash scripts/scan-public.sh .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
